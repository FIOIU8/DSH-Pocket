<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- DSH_HOME contains credentials, session state and logs. The runtime can be reinstalled. -->
        <exclude domain="file" path="dsh-home" />
        <exclude domain="file" path="runtime" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="dsh-home" />
        <exclude domain="file" path="runtime" />
    </device-transfer>
</data-extraction-rules>
