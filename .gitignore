local.properties

# Runtime collection work area (Termux closure, npm bundle, built zips) - GBs
/.runtime-work/
# Gradle user home mirrored into the workspace (the DSH sandbox cannot write
# outside it); ~1.6 GB of caches that must never be committed.
/.gradle-home/
# Kotlin Gradle plugin local state
/.kotlin/
# Python bytecode from tools/
__pycache__/
# The collected runtime is built by tools/collect_runtime.py and staged here for
# packaging; it is ~120 MB and must never be committed.
/app/src/main/assets/*.zip
# Local debug signing key: AGP's public debug credentials, kept inside the project
# because the build sandbox cannot write ~/.android.
/.keystore/
# Signing keystores must never be committed; the release key is injected via
# repository secrets in CI. A local release-keystore.jks was found untracked in
# the repo root on 2026-10-20 - *.jks covers it and any future key file.
*.jks
# WorkBuddy agent workspace (memory logs, task state) - local only.
/.workbuddy/
